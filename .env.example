# ============================================
# ChatGPT2API image workspace 环境变量示例
# 复制为 .env 后，docker compose 会自动把这些值注入容器。
# 当前 compose / Web 工作台可在“无任何环境变量”下直接启动；
# 以下变量全部按需填写。
# ============================================

# 管理员密码（仅当需要管理员登录 /admin 时才填写）
# CHATGPT2API_ADMIN_PASSWORD=change_me

# 会话签名密钥（可选）
# 默认会自动生成并持久化到 ./data/session_secret.txt。
# 若你使用多实例部署，或不打算持久化 ./data，建议显式设置。
# CHATGPT2API_SESSION_SECRET=replace_with_a_long_random_secret

# 全局上游配置（可选）
# 不填写时，普通用户仍可在登录页输入自己的 upstream URL + Key。
# 管理员登录后也可以在后台保存这两个值到 ./data/config.json。
# CHATGPT2API_UPSTREAM_API_URL=https://your-newapi.example.com/v1
# CHATGPT2API_UPSTREAM_API_KEY=sk-xxxx

# 可选网络 / 链接配置
# CHATGPT2API_PROXY=http://127.0.0.1:7890
# CHATGPT2API_BASE_URL=https://your-domain.example.com
# CHATGPT2API_IMAGE_RETENTION_DAYS=30
# CHATGPT2API_MAX_IMAGES_PER_REQUEST=10

# ============================================
# 仅供辅助脚本使用（当前 compose / Web 运行时不会读取）
# - scripts/migrate_storage.py
# - scripts/test_storage.py
# ============================================

# 存储后端类型（json / sqlite / postgres / git）
# STORAGE_BACKEND=json

# 数据库连接串（仅当 STORAGE_BACKEND=sqlite/postgres 时使用）
# DATABASE_URL=postgresql://user:password@localhost:5432/chatgpt2api
# DATABASE_URL=sqlite:///app/data/accounts.db

# Git 存储配置（仅当 STORAGE_BACKEND=git 时使用）
# GIT_REPO_URL=https://git.example.com/your-username/your-private-repo.git
# GIT_TOKEN=your_git_token_here
# GIT_BRANCH=main
# GIT_FILE_PATH=accounts.json
